BOT_TOKEN=1234567890:PUT_YOUR_TOKEN_HERE
ADMIN_IDS=111111111,222222222

# Временная БД (по умолчанию SQLite). Для PostgreSQL позже задайте URL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///timewise.db
DB_AUTO_CREATE=1
SCHEDULER_ENABLED=1
SCHEDULER_RUN_ON_STARTUP=1
SCHEDULER_DAILY_TIME=09:00
WORKER_ENABLED=1
WORKER_POLL_INTERVAL_SEC=5
APPROVAL_TIMEOUT_HOURS=8
RETRY_DELAYS_MIN=15,30,60
DEFAULT_MESSAGE_LANGUAGE=ru
LOG_LEVEL=INFO
OBSERVABILITY_ENABLED=1
OBSERVABILITY_HOST=0.0.0.0
OBSERVABILITY_PORT=9108
OBSERVABILITY_METRICS_INTERVAL_SEC=30
LOG_FILE_PATH=logs/timewise.jsonl

